# Copy this file to .env and fill in the values before running locally.

# Flask secret key — change to a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Admin password for /admin
ADMIN_PASSWORD=your-admin-password-here

# Path where the SQLite database is stored.
# Leave blank to use ./data inside the interface directory.
# DATA_DIR=

# Optional: edge patient calculator HTML for /manager/randpatient-calculator.
# Default: bundled file interface/static/tools/edge_patient_calculator.html.
# You can also rely on ../hospMort/scripts/results/… if present.
# EDGE_PATIENT_CALCULATOR_HTML=/path/to/edge_patient_calculator.html

# OpenAI API key (required for the LLM chat feature in Group B).
# You may use OPENAI_API instead of OPENAI_API_KEY if preferred.
OPENAI_API_KEY=sk-...

# Optional: override model (default in prompts.py is o4-mini-2025-04-16).
# OPENAI_MODEL=o4-mini-2025-04-16

# Reasoning models (o*) split max_completion_tokens between hidden reasoning and visible text.
# If toelichting panels stay empty, increase the floor (app default is 8192).
# OPENAI_REASONING_TOKEN_FLOOR=8192
# OPENAI_REASONING_EFFORT=low

# Co-12 Continuity: KAN forward pass on slightly perturbed inputs; stap 3 chart + LLM
# use updated probability and dynamically re-selected panels (steps 1–2 unchanged).
# PERTURBATION=1
